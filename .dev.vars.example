# Copy this file to `.dev.vars` for local Cloudflare Pages development.
# Never commit `.dev.vars` or paste production credentials into source files.

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_ROTATED_WEBHOOK
ALLOWED_ORIGIN=http://localhost:8788
DISCORD_CLIENT_ID=replace_with_discord_application_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
OAUTH_STATE_SECRET=replace_with_at_least_32_random_characters
ADMIN_PASSWORD_HASH=sha256_hash_of_your_admin_password
