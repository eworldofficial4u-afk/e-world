  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "deploy": "next build && npx wrangler pages deploy out --project-name e-world --branch main --commit-dirty=true",
    "postinstall": "node -e \"const fs=require('fs'); const p='node_modules/three/examples/jsm/postprocessing/Pass.js'; if(fs.existsSync('app/shims/Pass.js') && !fs.existsSync(p)) { fs.mkdirSync('node_modules/three/examples/jsm/postprocessing', {recursive:true}); fs.copyFileSync('app/shims/Pass.js', p); }\""
  },
