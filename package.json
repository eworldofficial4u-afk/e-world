    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-skinview3d": "^7.0.0",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^3.7.0",
