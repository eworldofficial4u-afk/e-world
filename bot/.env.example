# Discord application credentials. Keep real values in bot/.env or Railway variables.
DISCORD_BOT_TOKEN=replace_with_rotated_bot_token
DISCORD_APPLICATION_ID=replace_with_discord_application_id
DISCORD_GUILD_ID=replace_with_discord_guild_id
DISCORD_STAFF_ROLE_ID=replace_with_staff_role_id

# Website integration.
EWORLD_API_URL=https://e-world-community.pages.dev/api/community-content
BOT_STATS_URL=https://e-world-community.pages.dev/api/bot/stats
BOT_STATS_SECRET=replace_with_shared_stats_secret
